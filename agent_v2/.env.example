# 复制为 .env 并填入本地密钥（.env 已被 .gitignore 忽略，不会提交）

# MLLM / vision route: DashScope + qwen3.5-27b
LABARM_MLLM_API_KEY=sk-your-dashscope-key
LABARM_MLLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LABARM_MLLM_MODEL=qwen3.5-27b

# Pure LLM route: DeepSeek
LABARM_LLM_API_KEY=sk-your-deepseek-key
LABARM_LLM_BASE_URL=https://api.deepseek.com
LABARM_LLM_MODEL=deepseek-chat

# Optional whole-video omni route
# LABARM_OMNI_MODEL=qwen3.5-omni-plus
# LABARM_OMNI_FPS=1
